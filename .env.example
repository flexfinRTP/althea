# Copy to .env.local. Do not put real keys, names, emails, or machine paths in this example.
# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_MODE=true
DEMO_REFERENCE_DATE=2026-09-13
DEMO_STAFF_KEY=change-me-demo-staff-key

# SQLite file. Created automatically at .data/althea.db. No Postgres install.
DATABASE_URL="file:../.data/althea.db"

# Roles / session
SESSION_SECRET=change-me-session-secret

# Privy — Althea Relief Treasury
