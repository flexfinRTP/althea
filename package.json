{
  "name": "althea",
  "version": "0.1.0",
  "private": true,
  "description": "Althea Care — patient financial advocacy and transparent charitable relief rail.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "contracts:compile": "hardhat compile",
    "contracts:test": "hardhat test",
    "deploy:arc:testnet": "hardhat run scripts/deploy-relief-pool.ts --network arcTestnet",
    "deploy:arc:mainnet": "hardhat run scripts/deploy-relief-pool.ts --network arcMainnet",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "seed": "tsx scripts/seed-fap.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.23",
    "@prisma/client": "^6.16.1",
    "@privy-io/node": "^0.6.2",
    "@privy-io/react-auth": "^3.0.1",
    "@worldcoin/idkit": "^4.2.2",
    "@worldcoin/idkit-core": "^4.2.2",
    "ai": "^5.0.29",
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "lucide-react": "^0.544.0",
    "next": "^15.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "viem": "^2.37.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@openzeppelin/contracts": "^5.4.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.3",
    "hardhat": "^2.26.3",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prisma": "^6.16.1",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
